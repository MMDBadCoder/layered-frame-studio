# Photo Frame 2D — environment configuration.
#
# scripts/install.sh generates the real .env automatically (including a random
# secret key). Copy this file only if you are configuring a server by hand.
#
# Format note: this file is also read by systemd's EnvironmentFile, so write
# plain KEY=VALUE lines with no quotes, no spaces around "=", and no `export`.

# Signing key for sessions and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it logs everyone out; it does NOT invalidate stored passwords.
PHOTO_FRAME_SECRET_KEY=change-me

# 0 in production. Never expose a DEBUG=1 server to the internet: Django's
# error pages reveal settings, source code and query values.
PHOTO_FRAME_DEBUG=0

# Port the gunicorn service binds to.
PHOTO_FRAME_PORT=8080
